# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

DB_DRIVERNAME=postgresql+psycopg2
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_DATABASE=your_database_name

# =============================================================================
# HUGGING FACE TOKEN
# =============================================================================

# Hugging Face token for accessing models and processors.
HF_TOKEN=your_huggingface_token

# =============================================================================
# DATA PATH
# =============================================================================

# Path to directory containing raw audio files.
DATA_PATH="/escutado-audios/HD3/"

# Path to JSON file with acoustic index extraction parameters.
CONFIG_PARAMS_PATH="config_params.json"

# Directory where output CSV files will be saved.
OUTPUT_DIR=output

# Existing output directory to resume an interrupted run.
# Leave empty to start a new run.
RESUME_OUTPUT_DIR=

# =============================================================================
# PROCESSING
# =============================================================================

# Use 0 to auto-detect CPU count.
MAX_WORKERS=0

# Processing mode: indices, embeddings, or both.
PROCESS_MODE=both
